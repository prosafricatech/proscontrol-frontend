# ProsControl frontend — copy to .env.local and fill in. Never commit real values.

# --- Backend API & auth (server-side only) ---
# Laravel API base URL, including /api/v1.
API_BASE_URL=http://127.0.0.1:8000/api/v1
# Random string used to sign NextAuth sessions (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=
# Public URL of this app.
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development

# --- Firebase push notifications (public web-app config) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Real-time (Laravel Reverb over WebSockets) ---
# Copy these from the backend .env: REVERB_APP_KEY, REVERB_HOST, REVERB_PORT,
# REVERB_SCHEME. The key is public. NEVER put REVERB_APP_SECRET here.
# If KEY or HOST is empty, the app falls back to polling only.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
# http locally, https in production.
NEXT_PUBLIC_REVERB_SCHEME=http

# Set to "off" to disable polling entirely, to test WebSockets on their own.
# Leave unset (or any other value) for normal behaviour.
# NEXT_PUBLIC_POLLING_FALLBACK=off
